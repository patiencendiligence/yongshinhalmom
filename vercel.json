{
  "version": 2,
  "redirects": [
    {
      "source": "/yongshinhalmom/(.*)",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/yongshinhalmom",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/example/(.*)",
      "destination": "/api/index.ts"
    },
    { "handle": "filesystem" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}